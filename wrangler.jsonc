{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Worker that serves www.hadrongbs.com (built with @opennextjs/cloudflare)
	"main": ".open-next/worker.js",
	"name": "main-website",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Careers job postings managed from the HR dashboard (/hr-dashboard).
	// No database_id: Wrangler creates the D1 database automatically on the first deploy.
	// Tables are created by the app on first use (src/lib/careers/db.ts).
	"d1_databases": [
		{
			"binding": "CAREERS_DB",
			"database_name": "hadron-careers"
		}
	],
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name
			"binding": "WORKER_SELF_REFERENCE",
			"service": "main-website"
		}
	],
	"observability": {
		"enabled": true
	}
}
