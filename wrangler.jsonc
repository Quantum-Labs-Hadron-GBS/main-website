{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Worker that serves www.hadrongbs.com (built with @opennextjs/cloudflare)
	"main": ".open-next/worker.js",
	"name": "hadron-gbs-website",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hadron-gbs-website"
		}
	],
	"observability": {
		"enabled": true
	}
}
